{
  "name": "chess-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop": "node desktop/RunDesktop.mjs",
    "journey": "node journeys/RunJourney.mjs",
    "build": "run-p check:code type-check \"build-only {@}\" --",
    "check:code": "node scripts/CodeAudit.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pinia": "^3.0.4",
    "sass": "^1.97.2",
    "stockfish": "19.0.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.2.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.5"
  }
}
